# --- Rust / Cargo -------------------------------------------------------------
# Salida de compilación (workspace en la raíz y proyectos en projects/).
/target/
**/target/
# Respaldos que genera rustfmt.
**/*.rs.bk
# Cargo.lock SÍ se versiona: builds reproducibles (es lo que recomiendan las notas,
# ver Semana 1). No añadas una regla para ignorarlo.

# --- Documentación (MkDocs) ---------------------------------------------------
/site/
.cache/

# --- Python (scripts/) ----------------------------------------------------------
__pycache__/
.venv/
.mypy_cache/
.ruff_cache/

# --- Node (cspell vía npx) --------------------------------------------------------
node_modules/

# --- Datos locales y binarios grandes -------------------------------------------
# Videos de prueba de los reproductores: no se versionan.
projects/**/*.mp4
/LOCAL_DATA/

# Artefactos que genera `cargo run -p xtask -- dist` (completions, man page)
/src/chapter_04/dist/
