  "version": "0.2",
  "language": "es,en",
  "import": [
    "@cspell/dict-es-es/cspell-ext.json"
  ],
  "dictionaries": [
    "es-es",
    "en_us",
    "rust",
    "softwareTerms",
    "companies"
  ],
  "files": [
    "docs/**/*.md",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "patterns": [
    {
      "name": "fenced-code",
      "pattern": "/^\\s*(`{3,}|~{3,})[\\s\\S]*?^\\s*\\1/gm"
    },
    {
      "name": "inline-code",
      "pattern": "/`[^`\\n]+`/g"
    },
    {
      "name": "bold-initial",
      "pattern": "/\\*\\*[A-Z]\\*\\*[a-z]+/g"
    }
  ],
  "ignoreRegExpList": [
    "fenced-code",
    "inline-code",
    "bold-initial",
    "Urls"
  ],
